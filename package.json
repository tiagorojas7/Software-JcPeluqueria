{
  "name": "jc-barberia-turnero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "docker:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @jc-barberia/infrastructure run db:migrate",
    "seed": "pnpm --filter @jc-barberia/infrastructure run db:seed",
    "dev:api": "pnpm --filter @jc-barberia/api run dev",
    "dev:worker": "pnpm --filter @jc-barberia/worker run dev",
    "dev:web": "pnpm --filter @jc-barberia/web run dev",
    "start:api": "pnpm --filter @jc-barberia/api run start",
    "start:worker": "pnpm --filter @jc-barberia/worker run start",
    "start:web": "pnpm --filter @jc-barberia/web run start"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
